{
  "name": "raybags-medialab-handlers",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript Lambda handlers for the three AWS portfolio projects (VOD pipeline, audio API, telemetry collector).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.738.0",
    "@aws-sdk/client-mediaconvert": "^3.738.0",
    "@aws-sdk/client-s3": "^3.738.0",
    "@aws-sdk/client-sqs": "^3.738.0",
    "@aws-sdk/client-ssm": "^3.738.0",
    "@aws-sdk/lib-dynamodb": "^3.738.0",
    "@aws-sdk/s3-request-presigner": "^3.738.0",
    "serverless-http": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
